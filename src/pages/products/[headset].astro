---
import type { InferGetStaticPropsType } from 'astro';
import Site from '../../layouts/Site.astro';
import ContentLink from '../../components/ContentLink.astro';
import { headsets } from '../../data/headsets';
import { homeHas } from '../../data/home';
import { emailHref, siteHref } from '../../data/site';
import { brandName, productLabels } from '../../data/site-settings.json';

export function getStaticPaths() {
  return headsets.map((product) => ({ params: { headset: product.slug }, props: { product } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { product } = Astro.props;
const { model, category, headline, description, image, imageAlt, features, specs, variants } = product;
const inquiry = emailHref(product.inquirySubject);
const productImage = siteHref(image);
---
<Site title={model + ' ' + category + ' | ' + brandName} description={description}>
  <section class="hero detail-hero headset-detail-hero">
    <div class="hero-light" aria-hidden="true"></div>
    <div class="shell hero-grid">
      <div class="hero-content">
        <a class="breadcrumbs" href={homeHas('headsets') ? '/#products' : '/'}>{productLabels.breadcrumb} <span aria-hidden="true">/</span> {model}</a>
        <p class="eyebrow">{category}</p>
        <h1>{model}<span class="cobalt">.</span></h1>
        <p class="headset-headline">{headline}</p>
        <p class="headset-intro">{description}</p>
        <div class="actions"><a class="button" href="#specifications">{product.specsLabel} <span aria-hidden="true">↗</span></a><a class="button ghost" href={inquiry}>{product.inquiryLabel}</a></div>
      </div>
      {productImage && <figure class="headset-detail-visual"><img src={productImage} alt={imageAlt} fetchpriority="high" /></figure>}
    </div>
  </section>

  <section class="section feature-band">
    <div class="shell">
      <h2>{productLabels.design}</h2>
      <div class="editorial-grid">
        {(features ?? []).map(({ title, text }) => <div><h3>{title}</h3><p>{text}</p></div>)}
      </div>
    </div>
  </section>

  <section id="specifications" class="section specs headset-specs">
    <div class="shell">
      <div class="specs-grid">
        <h2>{productLabels.specifications}</h2>
        <dl>{(specs ?? []).map(({ label, value }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
      </div>
      <div class="headset-variants">
        {(variants ?? []).map((variant) => (
          <article class="headset-variant">
            <h3>{variant.name}</h3>
            <p>{variant.description}</p>
            <dl>{(variant.specs ?? []).map(({ label, value }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
            <ContentLink action={variant.action} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="partners">
    <div class="shell partners-grid">
      <h2>{product.partnerHeading}</h2>
      <div>
        <p>{product.partnerText}</p>
        <a class="button button-white" href={inquiry}>{product.partnerLabel} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <nav class="shell headset-related" aria-label="Other gaming headsets">
    {headsets.filter(({ model: otherModel }) => otherModel !== model).map(({ model: otherModel, slug }) => (
      <a class="text-link" href={'/products/' + slug + '/'}>{productLabels.related} {otherModel} <span aria-hidden="true">↗</span></a>
    ))}
  </nav>
</Site>
