---
import Site from '../layouts/Site.astro';
import HomeSection from '../components/HomeSection.astro';
import HomeStudio from '../components/HomeStudio.astro';
import { homeSections, homeHas } from '../data/home';
import content from '../data/home-content.json';
import { brandName } from '../data/site-settings.json';

const anchors: Record<string, string> = { demo: 'technology', headsets: 'products', community: 'community', partners: 'partners' };
const used = new Set<string>();
const sections = homeSections.map((section) => {
  const first = !used.has(section.type);
  used.add(section.type);
  return { section, anchor: first ? anchors[section.type] : undefined, primary: first && section.type === 'hero' };
});
const showStudio = import.meta.env.DEV || import.meta.env.PUBLIC_PREVIEW_STUDIO === 'true';
---
<Site title={content.title} description={content.description}>
  {!homeHas('hero') && <h1 class="sr-only">{brandName}</h1>}
  <div id="home-sections">
    {sections.map(({ section, anchor, primary }) => (
      <div data-home-section={section.type}><HomeSection section={section} anchor={anchor} primary={primary} /></div>
    ))}
  </div>
  {showStudio && <HomeStudio />}
</Site>
